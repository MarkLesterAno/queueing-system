{
  "nodes": [
    {
      "id": "readme_doc",
      "label": "QueueFlow README",
      "file_type": "document",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "queueflow_system",
      "label": "QueueFlow System",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Real-time queue management system for multi-office service desks. Centralized ticket issuance, per-office displays, operator controls, supervisor oversight. Built on Next.js, Upstash Redis, SSE."
    },
    {
      "id": "nextjs_16",
      "label": "Next.js 16 (App Router)",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Framework choice enables server-side rendering, API routes, and edge deployment on Vercel with zero-config caching."
    },
    {
      "id": "upstash_redis",
      "label": "Upstash Redis",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Serverless Redis for all state storage per office. Free tier supports ~1000 RPS, sufficient for 8 offices under modest load."
    },
    {
      "id": "sse_mechanism",
      "label": "Server-Sent Events",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Used for public display boards to push real-time updates every 1-2 seconds, reducing polling overhead. Scales linearly with display count."
    },
    {
      "id": "swr_polling",
      "label": "SWR Polling",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Client-side polling at 1.5-2 second intervals for operator panels; balances responsiveness vs API load."
    },
    {
      "id": "react_19",
      "label": "React 19",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "UI library for building interactive components with server components via Next.js App Router."
    },
    {
      "id": "tailwind_css_4",
      "label": "Tailwind CSS 4",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Utility-first CSS using semantic design tokens (--color-*, --radius). Prefer gap over margin/padding spacing."
    },
    {
      "id": "shadcn_ui",
      "label": "shadcn/ui",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Component library for base UI primitives (dialogs, buttons, selectors, modals)."
    },
    {
      "id": "framer_motion",
      "label": "Framer Motion",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Animation library for transitions and UI interactions."
    },
    {
      "id": "figtree_font",
      "label": "Figtree Font",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Sans-serif typeface (400-600 weight) used for headings and body copy, part of Swiss design aesthetic."
    },
    {
      "id": "dm_mono_font",
      "label": "DM Mono Font",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Monospace typeface used for numbers, codes, and labels."
    },
    {
      "id": "swiss_design_aesthetic",
      "label": "Swiss Graphic Design Aesthetic",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Grid-based layout, clean typography, functional minimalism. Influences typography choices (Figtree, DM Mono) and dark mode presentation."
    },
    {
      "id": "dark_mode_design",
      "label": "Dark Mode Design",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Primary aesthetic choice: black (#0A0A0A) background, off-white (#F0EDE8) foreground, amber (#F5A623) accent. Reduces eye strain for operators working in dim environments."
    },
    {
      "id": "design_system_tokens",
      "label": "Design System Color Tokens",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Semantic tokens: Primary #F5A623 Amber, Background #0A0A0A Black, Foreground #F0EDE8 Off-white, Card #111111, Border #222222, Muted #6B6B6B. Per-office colors (HR Green, FIN Orange, REG Blue, etc.) for visual distinction."
    },
    {
      "id": "ticket_lifecycle",
      "label": "Ticket Lifecycle States",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Six states: Waiting (issued, queue position) -> Called (operator announces) -> Serving (at counter) -> Done (complete, eligible for transfer) -> Hold (paused for documents) -> Skipped (returned to waiting). Transfer maintains same ticket ID across offices."
    },
    {
      "id": "redis_data_model",
      "label": "Redis Data Model",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Four keys per office: queue:{office}:tickets (JSON array of Ticket objects), queue:{office}:next_seq (incrementing integer), queue:{office}:serving (counter->ticket map), queue:{office}:counters (active count)."
    },
    {
      "id": "pin_authentication",
      "label": "PIN Authentication",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "4-digit PIN per office (ADMIN_PIN_{OFFICE}) plus universal ADMIN_PIN fallback. Supervisor uses ADMIN_PIN only. Per-office PINs override universal if set."
    },
    {
      "id": "kiosk_auto_reset",
      "label": "Kiosk Auto-reset",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "After 30 seconds of inactivity, the kiosk returns to the office grid to prevent lingering on stale screens in public kiosk mode."
    },
    {
      "id": "central_kiosk",
      "label": "Central Kiosk",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Route /kiosk. Unified ticket issuance with office card grid showing live queue depth and estimated wait times. Auto-resets after 30s inactivity."
    },
    {
      "id": "display_board",
      "label": "Per-Office Display Board",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Route /display/[office]. Shows Now Serving with counter assignments and Next Up indicator. Live SSE updates every 1-2 seconds. Designed for office TVs."
    },
    {
      "id": "operator_panel",
      "label": "Operator Panel",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Route /operator/[office]. PIN-protected. Actions: Call Next, Serve, Complete, Hold, Skip, Transfer, Re-call. Counter selection header. SWR polling every 1.5s."
    },
    {
      "id": "supervisor_dashboard",
      "label": "Supervisor Dashboard",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Route /supervisor. Bird's-eye view: office cards with queue depth, avg wait, served count. Add/remove counters, track idle counters, reset office, export CSV."
    },
    {
      "id": "ticket_transfer",
      "label": "Ticket Transfer",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Transfer done tickets to other offices while preserving ticket ID (e.g., FI-001 stays FI-001). Removed from source, added as fresh Waiting in destination."
    },
    {
      "id": "csv_export",
      "label": "CSV Export",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Supervisor can download full queue history as CSV for reporting and analysis."
    },
